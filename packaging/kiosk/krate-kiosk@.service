# Krate full screen on a dedicated player (docs/PLAYER.md): cage, a kiosk
# compositor, showing only Krate, on its own console, logged in as the user
# named by the instance (krate-kiosk@jaimie). Not enabled by installing it:
#   sudo systemctl enable krate-kiosk@<user>
#   sudo systemctl set-default graphical.target
# Krate starting again if it quits or crashes. Ctrl+Alt+F2 (cage -s) for a text
# console. After cage's own "start on boot" example.

[Unit]
Description=Krate full screen (cage) for %i
Documentation=file:///usr/share/doc/krate/PLAYER.md
# Once logins are allowed (and Plymouth is on its way out).
After=systemd-user-sessions.service plymouth-quit-wait.service
# Logind gives the session its seat (the screen, the keyboard).
Wants=dbus.socket systemd-logind.service
After=dbus.socket systemd-logind.service
# Its console: no login prompt there.
Conflicts=getty@tty7.service
After=getty@tty7.service
ConditionPathExists=/dev/tty0
Before=graphical.target

[Service]
Type=simple
User=%i
# A full login session for the user (PAM, logind, the user's systemd: PipeWire).
PAMName=krate-kiosk
TTYPath=/dev/tty7
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty7
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
# -d: no window decorations; -s: Ctrl+Alt+F<n> still switches consoles.
ExecStart=/usr/bin/cage -d -s -- /usr/bin/krate-kiosk
Restart=always
RestartSec=2

[Install]
WantedBy=graphical.target
